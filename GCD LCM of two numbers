
#include <stdio.h>

int main() {
    int a, b, x, y, r, gcd, lcm;

    printf("Enter two positive numbers: ");
    scanf("%d %d", &a, &b);

    if (a <= 0 || b <= 0) {
        printf("Enter positive numbers only");
        return 0;
    }

    x = a;
    y = b;

    while (y != 0) {
        r = x % y;
        x = y;
        y = r;
    }

    gcd = x;
    lcm = (a / gcd) * b;

    printf("GCD = %d\n", gcd);
    printf("LCM = %d\n", lcm);

    return 0;
}
