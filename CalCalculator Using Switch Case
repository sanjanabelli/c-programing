#include <stdio.h>

int main() {
    double a, b;
    char op;

    printf("Enter operator (+,-,*,/): ");
    scanf(" %c", &op);

    printf("Enter two numbers: ");
    scanf("%lf %lf", &a, &b);

    switch(op) {
        case '+': printf("Result = %.2lf", a+b); break;
        case '-': printf("Result = %.2lf", a-b); break;
        case '*': printf("Result = %.2lf", a*b); break;
        case '/':
            if(b != 0)
                printf("Result = %.2lf", a/b);
            else
                printf("Division by zero not allowed");
            break;
        default:
            printf("Invalid operator");
    }
    return 0;
}
